# Copy to config.ini. No secrets go in this file — API keys come from the
# environment variable named in api_key_env.

[judge]
# The model DeepEval uses to score responses. On GitHub Models, so the judge
# draws on a completely separate quota from the Groq candidate — the two
# can't starve each other no matter how large the test set gets.
# In Actions this authenticates with the built-in GITHUB_TOKEN; the job needs
# `permissions: models: read`.
provider = openai
model = openai/gpt-4o-mini
base_url = https://models.github.ai/inference
api_key_env = GH_MODELS_TOKEN

[candidate]
# The model(s) being evaluated. Either define one inline like [judge], or
# point at multiple sections for side-by-side comparison:
sections = candidate_groq

[candidate_groq]
provider = openai
model = qwen/qwen3.6-27b
base_url = https://api.groq.com/openai/v1
api_key_env = LLM_API_KEY

# Bedrock example (uses your AWS credentials / region):
# [candidate_claude]
# provider = bedrock
# model = anthropic.claude-sonnet-4-6
# region = us-east-1
